{
  "name": "dashboard-skeleton",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build-with-max:ts": "cross-env NODE_OPTIONS=--max_old_space_size=4096 tsc -b",
    "build-with-max:vite": "cross-env NODE_OPTIONS=--max_old_space_size=4096 vite build",
    "build-with-max": "npm run build-with-max:ts && build-with-max:vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "sonar": "node config/deploy/sonarqube.js",
    "test": "vitest"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.2.8",
    "antd": "^5.22.1",
    "axios": "^1.7.7",
    "chart.js": "^4.4.6",
    "chroma-js": "^3.1.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "i18next": "^23.16.0",
    "leaflet": "^1.9.4",
    "lodash": "^4.17.21",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-i18next": "^15.0.3",
    "react-leaflet": "^4.2.1",
    "react-qr-code": "^2.0.15",
    "react-redux": "^9.1.2",
    "react-router-dom": "^6.26.2",
    "react-to-print": "^3.0.2",
    "redux-persist": "^6.0.0",
    "tailwind-merge": "^2.5.3",
    "use-debounce": "^10.0.4"
