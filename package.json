{
  "name": "dashboard-skeleton",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build-with-max:ts": "cross-env NODE_OPTIONS=--max_old_space_size=4096 tsc -b",
    "build-with-max:vite": "cross-env NODE_OPTIONS=--max_old_space_size=4096 vite build",
    "build-with-max": "npm run build-with-max:ts && npm run build-with-max:vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "sonar": "node config/deploy/sonarqube.js",
    "test": "vitest"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "antd": "^5.29.3",
    "axios": "^1.20.0",
    "chart.js": "^4.5.1",
    "chroma-js": "^3.2.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "i18next": "^23.16.8",
    "leaflet": "^1.9.4",
    "lodash": "^4.17.21",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.86.0",
    "react-i18next": "^15.7.4",
    "react-leaflet": "^4.2.1",
    "react-qr-code": "^2.2.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^6.30.6",
    "react-to-print": "^3.3.0",
    "redux-persist": "^6.0.0",
    "tailwind-merge": "^2.6.1",
    "use-debounce": "^10.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/leaflet": "^1.9.22",
    "@types/lodash": "^4.17.25",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/tinycolor2": "^1.4.6",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "jest-sonar-reporter": "^2.0.0",
    "postcss": "^8.5.26",
    "prop-types": "^15.8.1",
    "sonarqube-scanner": "^4.4.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
